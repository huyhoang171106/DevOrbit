# ============================================
# DevOrbit — Environment Variables Template
# ============================================
# Copy to .env, fill secrets, never commit .env
#
# Usage:
#   devorbit-api/   → reads via application.yaml (${VAR})
#   devorbit-web/   → reads via Vite (VITE_*)
#   devorbit-mobile/→ reads via gradle.properties → BuildConfig
#
# For Docker Compose: docker compose --env-file .env up

# ── Database (PostgreSQL) ──────────────────────────
POSTGRES_DB=devorbit_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# ── API (Spring Boot) ──────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/devorbit_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me
JPA_DDL_AUTO=none
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
SQL_INIT_MODE=never
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── JWT ────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-256-bit-key
JWT_EXPIRATION_MINUTES=120

# ── GitHub ─────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# ── Supabase (Photobooth storage) ──────────────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=devorbit

# ── Mail (SMTP) ────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── OpenAPI / Swagger Contact ──────────────────────
API_CONTACT_EMAIL=devorbit@uit.edu.vn

# ── Web (Vite dev server) ──────────────────────────
VITE_API_BASE_URL=/api
WEB_PORT=5173
VITE_PROXY_TARGET=http://localhost:8080
VITE_ALLOWED_HOSTS=localhost

# ── Mobile ─────────────────────────────────────────
MOBILE_API_BASE_URL=http://10.0.2.2:8080

# ── Docker / Nginx ────────────────────────────────
NGINX_PORT=80
NGINX_API_PROXY_PASS=http://api:8080
