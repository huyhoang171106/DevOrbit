# Auto detect text files and perform LF normalization
* text=auto

# Java / Kotlin / TypeScript / JavaScript — always LF
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.py text eol=lf
*.sh text eol=lf

# PowerShell — always CRLF
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Binary files — no diff, no merge, no LF conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
*.bmp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.glb binary
*.gltf binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.jar binary
*.class binary
*.war binary
*.exe binary
*.dll binary
