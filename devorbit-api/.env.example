# ============================================
# DevOrbit API — Environment Template
# ============================================
# Copy to .env and fill in your values.

# ── Database ──────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/devorbit_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me
JPA_DDL_AUTO=none
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
SQL_INIT_MODE=never

# ── Server ─────────────────────────────────────────
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ── JWT ────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-256-bit-key
JWT_EXPIRATION_MINUTES=120

# ── GitHub API ─────────────────────────────────────
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_USER_AGENT=DevOrbit/1.0

# ── Supabase Storage ──────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=devorbit

# ── Mail (SMTP) ────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── OpenAPI / Swagger ──────────────────────────────
OPENAPI_LOCAL_DEV_URL=http://localhost:8080
API_CONTACT_EMAIL=devorbit@uit.edu.vn

# ── OpenCode AI ─────────────────────────────────────
OPENCODE_API_KEY=
OPENCODE_API_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4-flash

# ── Embedding (Fireworks AI) ────────────────────────
EMBEDDING_OFFLINE=false
EMBEDDING_PROVIDER=fireworks
EMBEDDING_MODEL=accounts/fireworks/models/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=4096
FIREWORKS_API_KEY=

# ── Exa Web Search ──────────────────────────────────
EXA_ENABLED=false
EXA_API_URL=https://api.exa.io
EXA_API_KEY=

# ── Firecrawl Search & Scrape ──────────────────────
FIRECRAWL_ENABLED=false
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_API_KEY=
