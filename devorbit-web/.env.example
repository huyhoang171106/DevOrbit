# ============================================
# DevOrbit Web — Environment Template
# ============================================
# Copy to .env and fill in your values.

# ── API base (used by fetch calls at runtime) ──────
VITE_API_BASE_URL=/api

# ── Dev server ─────────────────────────────────────
WEB_PORT=5173
VITE_PROXY_TARGET=http://localhost:8080
VITE_ALLOWED_HOSTS=localhost
